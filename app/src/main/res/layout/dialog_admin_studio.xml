<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/slate_900">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠️ Admin Bus Studio"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Create &amp; Edit Unique Bus Schedules &amp; Destinations"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@color/slate_700" />

        <!-- Bus Details Section -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bus Name / Line Code (e.g. City Express 404)"
            android:textColorHint="@color/text_muted"
            app:boxStrokeColor="@color/offroute_orange_light"
            app:hintTextColor="@color/offroute_orange_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBusName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Final Destination Name (e.g. North Terminal Depot)"
            android:textColorHint="@color/text_muted"
            app:boxStrokeColor="@color/offroute_orange_light"
            app:hintTextColor="@color/offroute_orange_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBusDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="STOPS &amp; SCHEDULE TIMELINE"
            android:textColor="@color/offroute_orange_light"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Dynamic Container for Stops -->
        <LinearLayout
            android:id="@+id/containerStops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Add Stop Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddStopRow"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="+ Add Intermediate Stop"
            android:textColor="@color/offroute_orange_light"
            app:strokeColor="@color/offroute_orange_light" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelStudio"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="Save Bus Schedule"
                android:textColor="@color/white"
                app:backgroundTint="@color/offroute_orange" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
