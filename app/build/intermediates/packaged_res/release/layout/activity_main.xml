<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/slate_900"
        tools:context=".MainActivity">

        <!-- Top AppBar Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/slate_800"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_offline_tracker"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Admin Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminPortal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Admin Login"
                        android:textSize="12sp"
                        android:textColor="@color/offroute_orange"
                        app:strokeColor="@color/offroute_orange" />
                </LinearLayout>

                <!-- Search Bar -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Search Destination or Route"
                    app:boxStrokeColor="@color/offroute_orange_light"
                    app:hintTextColor="@color/offroute_orange_light"
                    app:endIconTint="@color/offroute_orange_light">

                    <AutoCompleteTextView
                        android:id="@+id/actvRouteSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Map Container (OSM Map + GPS FAB) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Floating My GPS Location Button -->
            <org.maplibre.android.maps.MapView
                android:id="@+id/osmMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabToggleGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:contentDescription="My Location GPS"
                android:src="@android:drawable/ic_menu_compass"
                app:backgroundTint="@color/offroute_orange"
                app:tint="@color/white" />

            <!-- Route Builder Controls (Hidden by default) -->
            <LinearLayout
                android:id="@+id/panelBuilderMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="16dp"
                android:background="@color/slate_800"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                android:elevation="8dp">

                <TextView
                    android:id="@+id/tvBuilderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Tap on map to add stops"
                    android:textColor="@color/offroute_orange"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuilderCancel"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:layout_marginEnd="8dp"
                        android:textColor="@color/text_muted"
                        app:strokeColor="@color/text_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuilderFinish"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Finish Route"
                        android:textColor="@color/slate_900"
                        app:backgroundTint="@color/offroute_orange" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Status Dashboard Panel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/slate_800"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvCurrentClockTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clock: 18:02:00"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:gravity="end"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStatusHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="En route to Stop B"
                        android:textColor="@color/offroute_orange_light"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDestinationBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dest: North Terminal"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/slate_700" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LAST PASSED"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLastPassedStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stop A @ 17:55"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT STOP ETA"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNextStopEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stop B in 8m 0s"
                            android:textColor="@color/offroute_orange"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/cbLiveTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:buttonTint="@color/offroute_orange"
                        android:checked="true" />

                    <SeekBar
                        android:id="@+id/seekBarBusPath"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="8dp"
                        android:progressTint="@color/offroute_orange"
                        android:thumbTint="@color/offroute_orange"
                        android:max="1000" />

                    <TextView
                        android:id="@+id/tvProgressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
